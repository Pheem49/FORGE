[app]
name = "{{APP_NAME}}"
version = "0.1.0"
identifier = "dev.forge.{{APP_SLUG}}"
assets = "ui"

[window]
title = "{{APP_TITLE}}"
width = 960
height = 640
resizable = true
devtools = true

[runtime]
default = "{{DEFAULT_RUNTIME}}"

[permissions]
mode = "enforce"
allow = [
  "greet",
  "window.*",
  "event.*",
]
