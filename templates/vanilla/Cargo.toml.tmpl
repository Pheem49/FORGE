[package]
name = "{{CRATE_NAME}}"
version = "0.1.0"
edition = "2024"

[features]
default = ["webview"]
webview = ["forge/webview", "forge/dev-tools", "forge/plugins"]
cef = ["forge/cef", "forge/dev-tools", "forge/plugins"]

[dependencies]
forge = {{FORGE_DEP_SPEC}}
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
