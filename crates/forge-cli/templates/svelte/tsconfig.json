{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["svelte"]
  },
  "include": ["src-ui/**/*.ts", "src-ui/**/*.d.ts", "src-ui/**/*.svelte"]
}
